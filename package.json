  "repository": "github.com/artttj/synto",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/build.js",
    "zip": "node scripts/zip.js",
    "release": "node scripts/release.js",
