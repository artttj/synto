    "release:major": "node scripts/release.js major",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "screenshots": "vitest --config vitest.e2e.config.ts test/e2e/screenshots.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.37",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "puppeteer": "^24.43.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "lucide": "^1.16.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
